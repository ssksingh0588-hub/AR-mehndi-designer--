 if(tab==='Designs'){$('#dn').onclick=()=>designForm();m.querySelectorAll('[data-de]').forEach(b=>b.onclick=()=>designForm(b.dataset.de));
  const act=(a,f)=>m.querySelectorAll(`[${a}]`).forEach(b=>b.onclick=()=>{const d=DB.designs.find(x=>x.id===b.getAttribute(a));f(d);save();renderAdmin()});
