 if(tab==='Bookings'){const draw=()=>{const q=$('#bq').value.toLowerCase(),s=$('#bs').value,dd=$('#bd').value;
   const l=B.filter(b=>(!q||(b.name+b.phone).toLowerCase().includes(q))&&(!s||b.status===s)&&(!dd||b.date===dd)).sort((a,b)=>a.date<b.date?-1:1);
   $('#bl').innerHTML=l.length?l.map(b=>`<div class="adm"><b>${esc(b.name)}</b> · ${esc(b.phone)}<br>${esc(b.date)} ${esc(b.time)} · ${esc(b.eventType)} · ${esc(b.people)} people<br>${esc(b.designName)} (${esc(b.designId)}) ${esc(b.unit)} ${esc(b.price)}<br>${esc(b.location)} · ${esc(b.service)}<br><span class="muted">${esc(b.notes)}</span><div class="two"><div><label>Status</label><select data-bs="${b.id}">${['Pending','Confirmed','Completed','Cancelled'].map(x=>`<option ${b.status===x?'selected':''}>${x}</option>`).join('')}</select></div><div><label>Agreed price ₹ (manual)</label><input data-bf="${b.id}:agreed" value="${esc(b.agreed)}"></div><div><label>Advance received ₹ (manual)</label><input data-bf="${b.id}:advance" value="${esc(b.advance)}"></div><div><label>Balance ₹</label><input readonly value="${b.agreed&&b.advance!==''?Math.max(0,b.agreed-b.advance):''}"></div></div><label>Private admin note</label><input data-bf="${b.id}:adminNote" value="${esc(b.adminNote)}"><br><button class="btn btn-w btn-s" data-bw="${b.id}">WhatsApp customer</button> <button class="btn btn-p btn-s" data-bv="${b.id}">Save</button></div>`).join(''):'<p>No requests found.</p>';
   $('#bl').querySelectorAll('[data-bw]').forEach(x=>x.onclick=()=>{const b=B.find(y=>y.id===x.dataset.bw);openWA(WA.followup(b),'91'+b.phone)});
   $('#bl').querySelectorAll('[data-bv]').forEach(x=>x.onclick=()=>{const b=B.find(y=>y.id===x.dataset.bv),ns=$(`[data-bs="${b.id}"]`).value;
    if(ns==='Confirmed'&&b.status!=='Confirmed'){const same=B.filter(y=>y.id!==b.id&&y.date===b.date&&y.status==='Confirmed');
     if(same.length>=S().capacity||DB.blocked.includes(b.date)){toast('Conflict: this date is full or blocked. Not confirmed.');return}
     if(same.some(y=>y.time===b.time)&&!confirm('Another confirmed booking is at the same time. Confirm anyway?'))return}
    b.status=ns;$('#bl').querySelectorAll(`[data-bf^="${b.id}:"]`).forEach(i=>b[i.dataset.bf.split(':')[1]]=i.value.trim());save();toast('Saved');draw()})};
  ['bq','bs','bd'].forEach(i=>$('#'+i).oninput=draw);draw();
  $('#csv').onclick=()=>{const cols=['id','created','name','phone','designId','designName','unit','eventType','date','time','people','location','service','notes','status','agreed','advance','adminNote'],q=v=>'"'+String(v??'').replace(/"/g,'""').replace(/^([=+\-@])/,"'$1")+'"';
   const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([cols.join(',')+'\n'+B.map(b=>cols.map(c=>q(b[c])).join(',')).join('\n')],{type:'text/csv'}));a.download='bookings.csv';a.click()}}}
function designForm(id){const d=DB.designs.find(x=>x.id===id)||{id:'D-'+String(DB.designs.length+1).padStart(3,'0'),cat:CATS[0],name:'',price:0,ptype:'fixed',desc:'',time:'',featured:false,enabled:true,img:''};
 dlg(`<h2>${id?'Edit':'Add'} design</h2><label>Design ID</label><input id="d-id" value="${esc(d.id)}" ${id?'readonly':''}><label>Name</label><input id="d-name" value="${esc(d.name)}"><label>Category</label><select id="d-cat">${CATS.map(c=>`<option ${c===d.cat?'selected':''}>${esc(c)}</option>`).join('')}</select><div class="two"><div><label>Price type</label><select id="d-pt">${[['fixed','Fixed'],['starting','Starting from'],['quote','Custom quote']].map(p=>`<option value="${p[0]}" ${d.ptype===p[0]?'selected':''}>${p[1]}</option>`).join('')}</select></div><div><label>Price ₹</label><input type="number" id="d-price" min="0" value="${d.price}"></div></div><label>Description</label><input id="d-desc" value="${esc(d.desc)}"><label>Approx. time</label><input id="d-time" value="${esc(d.time)}"><label>Photo (replaces sample art)</label><input type="file" id="d-img" accept="image/*"><div class="err" id="d-err"></div><p class="muted">Demo: photo is resized and kept in this browser. Production uses Supabase Storage.</p><button class="btn btn-p" id="d-save">Save</button> <button class="btn btn-o" data-close>Cancel</button>`);
 $('#d-save').onclick=async()=>{const n=$('#d-name').value.trim(),nid=$('#d-id').value.trim();if(!n||!nid){$('#d-err').textContent='Name and ID are required.';return}if(!id&&DB.designs.some(x=>x.id===nid)){$('#d-err').textContent='ID already used.';return}
  Object.assign(d,{id:nid,name:n,cat:$('#d-cat').value,ptype:$('#d-pt').value,price:Math.max(0,+$('#d-price').value||0),desc:$('#d-desc').value.trim(),time:$('#d-time').value.trim()});
  const f=$('#d-img').files[0];if(f){try{d.img=await shrink(f)}catch(e){$('#d-err').textContent='Could not read that image.';return}}
  if(!id)DB.designs.push(d);save();$('#dlg').close();renderAdmin()}}
function shrink(f){return new Promise((ok,no)=>{const i=new Image;i.onload=()=>{const r=Math.min(1,800/i.width),c=document.createElement('canvas');c.width=i.width*r;c.height=i.height*r;c.getContext('2d').drawImage(i,0,0,c.width,c.height);ok(c.toDataURL('image/jpeg',.75))};i.onerror=no;i.src=URL.createObjectURL(f)})}
