 if(tab==='Settings')body=`<div class="adm">${[['name','Business name'],['phone','Contact number'],['whatsapp','WhatsApp number (10 digits, no +91)'],['city','Service city'],['address','Shop / home address (shown after booking)'],['map','Google Maps link (optional)'],['instagram','Instagram URL'],['timings','Business timings'],['areas','Service areas','area'],['bio','Artist biography','area'],['exp','Experience (only true facts)','area'],['pricingPolicy','Pricing policy','area'],['bookingPolicy','Booking policy','area'],['cancelPolicy','Cancellation policy','area'],['travel','Travel charges','area']].map(f=>fld(f[0],f[1],S()[f[0]],f[2]||'text')).join('')}<br><button class="btn btn-p" id="ss">Save settings</button></div><div class="adm"><b>Demo data</b><br><button class="btn btn-o btn-s" id="rs">Reset all demo data</button> <button class="btn btn-o btn-s" id="lo">Log out</button></div>`;
